FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package.json bun.lock ./

# Install all dependencies
RUN npm install

# Make sure npx can find the local astro installation
ENV PATH="/app/node_modules/.bin:${PATH}"

# Expose the development server port
EXPOSE 4321

# Verify that astro is available
RUN ls -la node_modules/.bin/

# Use CMD to make it easily overridable in docker-compose
CMD ["npm", "run", "dev", "--", "--host"]