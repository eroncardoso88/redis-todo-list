---
import { isAuthenticated } from '../middleware/auth';
import MainLayout from './main-layout.astro';

const authenticated = await isAuthenticated(Astro.request);
if (authenticated === false) {
  return Astro.redirect('/login?redirect=' + encodeURIComponent(Astro.url.pathname));
}

const { title = 'Dashboard' } = Astro.props;
---

<MainLayout title={title}>
  <div class="min-h-screen bg-gray-100">
    <nav class="bg-white shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex">
            <!-- Your navigation links here -->
          </div>
          <div class="flex items-center">
            <button id="logout-button" class="ml-3 bg-white p-1 rounded-full text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
              Logout
            </button>
          </div>
        </div>
      </div>
    </nav>

    <div class="py-10">
      <header>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h1 class="text-3xl font-bold leading-tight text-gray-900">
            {title}
          </h1>
        </div>
      </header>
      <main>
        <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
          <div class="px-4 py-8 sm:px-0">
            <slot />
          </div>
        </div>
      </main>
    </div>
  </div>
</MainLayout>

<script>
  import authService from '../services/auth-service';
  
  // Handle logout button
  document.getElementById('logout-button')?.addEventListener('click', async () => {
    try {
      await authService.logoutUser();
      window.location.href = '/login';
    } catch (error) {
      console.error('Logout failed:', error);
      localStorage.removeItem('authToken');
      localStorage.removeItem('sessionId');
      localStorage.removeItem('user');
      document.cookie = 'authToken=; path=/; max-age=0';
      window.location.href = '/login';
    }
  });
  
  if (!authService.isAuthenticated()) {
    window.location.replace('/login');
  }
</script>